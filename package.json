{
  "name": "docs-antora",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal Antora site",
  "scripts": {
    "start": "antora antora-playbook.yml && http-server build/site -c-1 -o",
    "rag:generate": "bundle exec ruby scripts/docs-rag.rb generate",
    "rag:validate": "bundle exec ruby scripts/docs-rag.rb validate",
    "rag:check": "bundle exec ruby scripts/docs-rag.rb check",
    "test:rag": "bundle exec ruby test/docs_rag_test.rb"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@antora/cli": "3.1.15",
    "@antora/site-generator": "3.1.15",
    "http-server": "14.1.1"
  }
}
